{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DJOrganizer",
  "version": "0.1.0",
  "identifier": "com.djorganizer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://djorganizer-beta.vercel.app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DJOrganizer",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["desktop-base"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
